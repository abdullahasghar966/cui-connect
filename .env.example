# Copy to .env (optional). Every value has a sensible default for local development.

# HTTP + Socket.IO port of the API server (the web dev server runs on 5173 and proxies to it)
API_PORT=4000

# MongoDB. Leave empty to use the embedded MongoDB (no install needed; data persists in .data/mongo).
# Example Atlas URI: mongodb+srv://user:pass@cluster0.xxxxx.mongodb.net/cui_connect
MONGODB_URI=

# Port used by the embedded MongoDB when MONGODB_URI is empty
EMBEDDED_MONGO_PORT=27019

# Secret used to sign session tokens. CHANGE THIS in any shared deployment.
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars

# Session lifetime (jose duration string)
JWT_TTL=12h

# Set to true only when serving over HTTPS
COOKIE_SECURE=false

# Seed demo data automatically when the database has no users
AUTO_SEED=true

LOG_LEVEL=info
