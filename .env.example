# Copy to .env (optional). Every value has a sensible default for local development.

# ---- Server ----
# HTTP + Socket.IO port of the API server (the web dev server runs on 5173 and proxies to it)
API_PORT=4000
LOG_LEVEL=info

# ---- Database ----
# Leave MONGODB_URI empty to use the embedded MongoDB (no install needed; data persists on disk).
# Example Atlas URI: mongodb+srv://user:pass@cluster0.xxxxx.mongodb.net/
MONGODB_URI=
MONGO_DB_NAME=cui_connect
# Port and data folder (relative to the repo root) of the embedded MongoDB
EMBEDDED_MONGO_PORT=27019
EMBEDDED_MONGO_DIR=.data/mongo

# ---- Sessions ----
# Secret used to sign session tokens (min 32 chars). If empty, a random one is generated
# once and stored in .data/jwt-secret.
JWT_SECRET=
# Session lifetime: 30m, 12h, 7d ...
JWT_TTL=12h
# Set to true only when serving over HTTPS
COOKIE_SECURE=false
# Proxy hops to trust for the client IP: loopback locally, 1 behind a host's load balancer
TRUST_PROXY=loopback
# When the database has no users, the browser shows a setup page that creates the first
# admin. If set, that page asks for this code first.
SETUP_CODE=

# ---- Demo data ----
# Seed the demo campus automatically when the database has no users
AUTO_SEED=true
# Show demo accounts on the login screen
DEMO_MODE=true
# "reset" wipes and re-seeds on every start (used by the end-to-end tests)
SEED_ON_START=none

# ---- Abuse protection ----
# Sign-in attempts per minute per IP
LOGIN_RATE_LIMIT=20
# Messages: burst size and sustained rate per connection
MESSAGE_BURST=8
MESSAGE_RATE_PER_SEC=2
